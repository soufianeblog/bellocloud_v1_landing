---
import { basePath, useTranslations, type Lang } from '../lib/i18n';
import { waLink, WHATSAPP_NUMBER } from '../lib/wa';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Absolute (language-prefixed) hrefs so links work from any page, not just /.
const columns = [
  {
    title: t('footer.products'),
    links: [
      { label: 'BelloCommerce', href: `https://bellocommerce.com/${lang}/`, external: true },
      { label: t('nav.products.store'), href: `https://bellocommerce.com/${lang}/online-store/`, external: true },
      { label: t('nav.products.pos'), href: `https://bellocommerce.com/${lang}/bellopos/`, external: true },
    ],
  },
  {
    title: t('footer.account'),
    links: [
      { label: t('nav.login'), href: `${basePath}/${lang}/login/` },
      { label: t('nav.signup'), href: `${basePath}/${lang}/signup/` },
      { label: t('nav.contact'), href: `${basePath}/${lang}/contact/` },
    ],
  },
  {
    title: t('footer.legal'),
    links: [
      { label: t('footer.privacy'), href: `${basePath}/${lang}/legal/privacy/` },
      { label: t('footer.terms'), href: `${basePath}/${lang}/legal/terms/` },
      { label: t('footer.cookies'), href: `${basePath}/${lang}/legal/cookies/` },
    ],
  },
];
---

<footer class="border-t border-black/5 bg-white dark:border-white/10 dark:bg-night">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <!-- Brand -->
      <div class="max-w-xs">
        {/* dir="ltr" pins the lockup so the icon stays left of CLOUD in RTL too */}
        <a href={`${basePath}/${lang}/`} dir="ltr" class="inline-flex items-center gap-2.5" aria-label="BelloCloud home">
          <img src="/bello-logo-blue.svg" alt="" width="28" height="28" class="h-7 w-7 shrink-0" />
          <span class="font-heading font-brand text-xl font-bold tracking-tight text-ink dark:text-white">CLOUD</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink/60 dark:text-white/60">{t('footer.tagline')}</p>

        <!-- Direct contact: call + WhatsApp + email -->
        <div class="mt-5 flex flex-col gap-2.5">
          <a
            href={`tel:+${WHATSAPP_NUMBER}`}
            class="inline-flex items-center gap-2.5 rounded-full border border-black/10 px-4 py-2.5 text-sm font-semibold text-ink/80 transition hover:border-black/25 hover:text-ink dark:border-white/15 dark:text-white/80 dark:hover:border-white/35 dark:hover:text-white"
          >
            <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
            {t('footer.call')}
          </a>
          <a
            href={waLink(t('wa.start'))}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2.5 rounded-full border border-black/10 px-4 py-2.5 text-sm font-semibold text-ink/80 transition hover:border-black/25 hover:text-ink dark:border-white/15 dark:text-white/80 dark:hover:border-white/35 dark:hover:text-white"
          >
            <svg class="h-4 w-4 shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.2 13.9c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .2-3.1-.7-2.6-1.1-4.2-3.8-4.4-4-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.2.1.4.1.5-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.5.3.1.3.1.7-.1 1.3Z"/></svg>
            {t('footer.whatsapp')}
          </a>
          <a
            href="mailto:contact@bellocloud.com"
            class="inline-flex items-center gap-2.5 rounded-full border border-black/10 px-4 py-2.5 text-sm font-semibold text-ink/80 transition hover:border-black/25 hover:text-ink dark:border-white/15 dark:text-white/80 dark:hover:border-white/35 dark:hover:text-white"
          >
            <svg class="h-4 w-4 shrink-0 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 3-10 6L2 7"/></svg>
            {t('contact.email.label')}
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <div>
          <h2 class="font-heading text-sm font-bold text-ink dark:text-white">{col.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined} class="text-sm text-ink/60 transition hover:text-ink dark:text-white/60 dark:hover:text-white">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-black/5 pt-8 dark:border-white/10 sm:flex-row">
      <p class="text-sm text-ink/60 dark:text-white/60">{t('footer.copyright')}</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href={`${basePath}/${lang}/legal/privacy/`} class="text-sm text-ink/60 transition hover:text-ink dark:text-white/60 dark:hover:text-white">{t('footer.privacy')}</a>
        <a href={`${basePath}/${lang}/legal/terms/`} class="text-sm text-ink/60 transition hover:text-ink dark:text-white/60 dark:hover:text-white">{t('footer.terms')}</a>
        <a href={`${basePath}/${lang}/legal/cookies/`} class="text-sm text-ink/60 transition hover:text-ink dark:text-white/60 dark:hover:text-white">{t('footer.cookies')}</a>
      </div>
    </div>
  </div>
</footer>
