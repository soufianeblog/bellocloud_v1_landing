    // Load on first interaction (scroll/tap/keys) so analytics costs nothing
    // during page load; the timer catches visitors who never interact.
    var phStarted = false;
    function startPostHog() {
        if (phStarted) return;
        phStarted = true;
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
            removeEventListener(ev, startPostHog, { passive: true });
