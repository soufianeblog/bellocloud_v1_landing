    // Defer init until the browser is idle so analytics never competes with
    // first paint / interactivity.
    function initPostHog() {
        posthog.init('phc_kGNeMEFWs8fnDQarHraCF4VweqcrYbPm6bWGECpp8LZp', {
            api_host: 'https://us.i.posthog.com',
