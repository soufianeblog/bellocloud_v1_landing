---
import { basePath, type Lang } from '../lib/i18n';
import type { LegalDoc } from '../lib/legal';

interface Props {
  lang: Lang;
  doc: LegalDoc;
  /** Localized "Last updated" label + date. */
  updatedLabel: string;
  updatedDate: string;
  backLabel: string;
}

const { lang, doc, updatedLabel, updatedDate, backLabel } = Astro.props;
---

<section class="bg-white py-24 dark:bg-night">
  <div class="mx-auto max-w-3xl px-5 sm:px-6">
    <div class="reveal">
      <span class="text-sm font-semibold uppercase tracking-wider text-accent">{updatedLabel}: {updatedDate}</span>
      <h1 class="font-heading mt-3 text-4xl font-bold leading-tight sm:text-5xl">{doc.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70 dark:text-white/70">{doc.intro}</p>

      <div class="mt-10 space-y-10">
        {doc.sections.map((s, i) => (
          <div>
            <h2 class="font-heading text-xl font-bold text-ink dark:text-white">{i + 1}. {s.heading}</h2>
            {s.body?.map((p) => (
              <p class="mt-3 leading-relaxed text-ink/70 dark:text-white/70">{p}</p>
            ))}
            {s.bullets && (
              <ul class="mt-3 space-y-2">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 leading-relaxed text-ink/70 dark:text-white/70">
                    <svg class="mt-1.5 h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>

      <a
        href={`${basePath}/${lang}/`}
        class="mt-12 inline-flex items-center gap-2 rounded-full border border-black/15 px-6 py-3 text-sm font-semibold text-ink transition hover:border-black/30 dark:border-white/20 dark:text-white dark:hover:border-white/40"
      >
        <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        {backLabel}
      </a>
    </div>
  </div>
</section>
