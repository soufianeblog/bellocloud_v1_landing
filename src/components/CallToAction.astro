---
import { basePath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="cta" class="bg-white py-24 dark:bg-night">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-ink to-[#0d1b36] px-8 py-16 text-center ring-1 ring-white/10 sm:px-16 dark:from-night-card dark:to-night">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-20 start-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-accent/30 blur-3xl"></div>
        <div class="absolute -bottom-24 end-0 h-64 w-64 rounded-full bg-accent/15 blur-3xl"></div>
        <div class="tech-grid absolute inset-0 opacity-[0.15]"></div>
      </div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="font-heading text-[clamp(1.125rem,5.5vw,1.875rem)] font-bold text-white sm:text-4xl">{t('cta.title')}</h2>
        <p class="mt-4 text-lg text-white/65">{t('cta.subtitle')}</p>
        <a
          href={`${basePath}/${lang}/signup/`}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white transition hover:bg-accent/90"
        >
          {t('cta.button')}
          <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
