---
import { useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = ['s1', 's2', 's3'];
---

<section id="how" class="mesh-dark relative py-24 text-white">
  <div class="tech-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-5 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-heading text-[clamp(1.25rem,6vw,1.875rem)] font-bold sm:text-4xl">{t('how.title')}</h2>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {steps.map((s, i) => (
        <article
          class="reveal group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] p-8 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-accent/50 hover:bg-white/[0.07]"
          style={`--reveal-delay:${i * 90}ms`}
        >
          <!-- soft accent wash in the card corner -->
          <div class="pointer-events-none absolute -end-10 -top-10 h-32 w-32 rounded-full bg-accent/15 blur-2xl transition-opacity duration-300 group-hover:bg-accent/25" aria-hidden="true"></div>

          <div class="relative">
            <div class="flex items-center gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent font-heading text-lg font-bold text-white shadow-lg shadow-accent/30">
                {i + 1}
              </span>
              <h3 class="text-lg font-bold text-white">{t(`how.${s}`)}</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-white/60">{t(`how.${s}.desc`)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
