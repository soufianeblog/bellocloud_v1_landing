---
// The full Contact page for one language. Shared by /[lang]/contact and the
// language-less /contact (which serves the default language directly).
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { useTranslations, type Lang } from '../lib/i18n';
import { WHATSAPP_NUMBER } from '../lib/wa';


interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = t('contact.meta.title');
const description = t('contact.meta.description');

const email = 'contact@bellocloud.com';
const phoneDisplay = '+212 6 12 25 78 94';
---

<Base lang={lang} title={title} description={description}>
  <Header lang={lang} />
  <main transition:animate="fade">
    <section class="mesh-light overflow-hidden py-20 lg:py-24">
      <div class="mx-auto max-w-3xl px-5 sm:px-6">
        <div class="reveal text-center">
          <h1 class="font-heading text-3xl font-bold leading-tight sm:text-4xl">{t('contact.title')}</h1>
          <p class="mx-auto mt-4 max-w-xl text-lg text-ink/65 dark:text-white/65">{t('contact.subtitle')}</p>
        </div>

        <!-- Email + call cards -->
        <div class="reveal mt-12 grid gap-6 sm:grid-cols-2" style="--reveal-delay:90ms">
          <a
            href={`mailto:${email}`}
            class="flex items-center gap-4 rounded-2xl border border-black/10 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10 dark:bg-night-card"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent dark:bg-accent/15">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 3-10 6L2 7"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-ink/60 dark:text-white/60">{t('contact.email.label')}</span>
              <span dir="ltr" class="block truncate text-lg font-bold text-ink dark:text-white">{email}</span>
            </span>
          </a>
          <a
            href={`tel:+${WHATSAPP_NUMBER}`}
            class="flex items-center gap-4 rounded-2xl border border-black/10 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10 dark:bg-night-card"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent dark:bg-accent/15">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-ink/60 dark:text-white/60">{t('footer.call')}</span>
              <span dir="ltr" class="block truncate text-lg font-bold text-ink dark:text-white">{phoneDisplay}</span>
            </span>
          </a>
        </div>

        <!-- Message box → WhatsApp -->
        <div class="reveal mt-6 rounded-2xl border border-black/10 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-night-card" style="--reveal-delay:180ms">
          <label for="contact-message" class="block text-sm font-semibold text-ink/60 dark:text-white/60">{t('contact.message.label')}</label>
          <textarea
            id="contact-message"
            rows="5"
            placeholder={t('contact.message.placeholder')}
            class="mt-3 w-full resize-y rounded-xl border border-black/10 bg-cream/50 px-4 py-3 text-base text-ink outline-none transition placeholder:text-ink/35 focus:border-accent/60 focus:ring-2 focus:ring-accent/20 dark:border-white/10 dark:bg-night dark:text-white dark:placeholder:text-white/35"
          ></textarea>
          <button
            type="button"
            id="contact-send"
            class="mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-emerald-700 px-7 py-3.5 text-base font-semibold text-white transition hover:bg-emerald-800"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.2 13.9c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .2-3.1-.7-2.6-1.1-4.2-3.8-4.4-4-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.2.1.4.1.5-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.5.3.1.3.1.7-.1 1.3Z"/></svg>
            {t('contact.send')}
          </button>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />

  <script>
    import { waLink } from '../lib/wa';

    // Delegated so it survives Astro ClientRouter page swaps.
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest?.('#contact-send')) return;
      const box = document.getElementById('contact-message') as HTMLTextAreaElement | null;
      const message = box?.value.trim() || 'Hello!';
      window.open(waLink(message), '_blank', 'noopener');
    });
  </script>
</Base>
