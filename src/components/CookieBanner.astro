---
import { basePath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Cookie consent banner: hidden until the script confirms no stored choice.
     The choice is persisted in localStorage ('cookie-consent'); any future
     analytics must check it before capturing. -->
<div
  id="cookie-banner"
  hidden
  class="fixed inset-x-0 bottom-0 z-[90] p-4 sm:p-5"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-3xl flex-col gap-4 rounded-2xl border border-black/10 bg-white p-5 shadow-2xl shadow-black/20 sm:flex-row sm:items-center dark:border-white/15 dark:bg-night-card dark:shadow-black/60">
    <p class="flex-1 text-sm leading-relaxed text-ink/75 dark:text-white/75">
      🍪 {t('cookie.text')}
      <a href={`${basePath}/${lang}/legal/cookies/`} class="font-semibold text-accent underline-offset-2 hover:underline">{t('footer.cookies')}</a>
    </p>
    <div class="flex shrink-0 items-center gap-2.5">
      <button
        type="button"
        data-cookie-choice="declined"
        class="rounded-full border border-black/15 px-5 py-2.5 text-sm font-semibold text-ink/70 transition hover:border-black/30 hover:text-ink dark:border-white/20 dark:text-white/70 dark:hover:border-white/40 dark:hover:text-white"
      >
        {t('cookie.decline')}
      </button>
      <button
        type="button"
        data-cookie-choice="accepted"
        class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent/90"
      >
        {t('cookie.accept')}
      </button>
    </div>
  </div>
</div>

<script>
  function syncCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;
    let choice: string | null = null;
    try { choice = localStorage.getItem('cookie-consent'); } catch {}
    banner.hidden = choice === 'accepted' || choice === 'declined';
  }
  syncCookieBanner();
  document.addEventListener('astro:page-load', syncCookieBanner);

  // Delegated so it survives Astro ClientRouter page swaps.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest?.('[data-cookie-choice]');
    if (!(btn instanceof HTMLElement)) return;
    try { localStorage.setItem('cookie-consent', btn.dataset.cookieChoice!); } catch {}
    document.getElementById('cookie-banner')?.setAttribute('hidden', '');
  });
</script>
