---
// Light/dark theme toggle. The initial class is set pre-paint in Base.astro;
// this button flips it and persists the choice to localStorage (handlers are
// bound globally in Base.astro so they survive View Transitions).
---

<button
  type="button"
  class="theme-toggle grid h-9 w-9 place-items-center rounded-full border border-black/10 text-ink/70 transition hover:border-black/25 hover:text-ink dark:border-white/15 dark:text-white/70 dark:hover:border-white/35 dark:hover:text-white"
  aria-label="Toggle dark mode"
>
  <!-- sun (shown in dark mode) -->
  <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- moon (shown in light mode) -->
  <svg class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
</button>
