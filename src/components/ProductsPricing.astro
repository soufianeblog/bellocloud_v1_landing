---
// Products & pricing: what BelloCloud LLC sells (BelloPOS, BelloSend), every
// public price with its currency and billing model, how to pay, and the
// policies that apply. Used on the home page (#pricing) and on /pricing/.
import { basePath, useTranslations, type Lang } from '../lib/i18n';
import { COMPANY } from '../lib/company';
import { waLink } from '../lib/wa';
import { bellopos, bellosend, formatPrice } from '../lib/pricing';

interface Props {
  lang: Lang;
  /** h1 on the dedicated /pricing/ page, h2 inside the home page. */
  as?: 'h1' | 'h2';
}

const { lang, as: Heading = 'h2' } = Astro.props;
const t = useTranslations(lang);

const usd = (n: number) => formatPrice(n, bellopos.currency, lang);
const eur = (n: number) => formatPrice(n, bellosend.currency, lang);

const u = bellosend.units;
const sendCustom = t('pricing.send.custom')
  .replace('{channel}', eur(u.channel))
  .replace('{user}', eur(u.extraUser))
  .replace('{automation}', `+${eur(u.automation)}`)
  .replace('{history}', `+${eur(u.unlimitedHistory)}`);

const policies = [
  { label: t('footer.refund'), href: `${basePath}/${lang}/legal/refund/` },
  { label: t('footer.terms'), href: `${basePath}/${lang}/legal/terms/` },
  { label: t('footer.privacy'), href: `${basePath}/${lang}/legal/privacy/` },
];

const card = 'reveal flex min-w-0 flex-col rounded-2xl border border-black/10 bg-white p-6 shadow-sm sm:p-8 dark:border-white/10 dark:bg-night-card';
const chip = 'inline-flex rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-accent/15 dark:text-accent';
const cell = 'py-3 pe-3 align-top';
const priceCell = `${cell} sm:whitespace-nowrap`;
const price = 'font-stat font-bold tabular-nums text-ink dark:text-white';
const unit = 'text-xs font-normal text-ink/55 dark:text-white/55';
---

<section id="pricing" class="scroll-mt-20 bg-cream/40 py-24 dark:bg-night-soft/40">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-accent">{t('pricing.eyebrow')}</span>
      <Heading class="font-heading mt-3 text-[clamp(1.25rem,6vw,1.875rem)] font-bold sm:text-4xl">{t('pricing.title')}</Heading>
      <p class="mt-4 text-lg text-ink/60 dark:text-white/60">{t('pricing.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <!-- BelloPOS: USD, monthly / yearly / one-time lifetime licence -->
      <article class={card}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-heading text-2xl font-bold">BelloPOS</h3>
          <span class={chip}>{t('pricing.pos.currency')}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink/65 dark:text-white/65">{t('pricing.pos.tagline')}</p>

        <div class="mt-5 overflow-x-auto">
          <table class="w-full text-start text-sm">
            <thead>
              <tr class="border-b border-black/10 text-xs uppercase tracking-wide text-ink/55 dark:border-white/10 dark:text-white/55">
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.plan')}</th>
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.monthly')}</th>
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.yearly')}</th>
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.lifetime')}</th>
              </tr>
            </thead>
            <tbody>
              {bellopos.plans.map((p) => (
                <tr class="border-b border-black/5 last:border-0 dark:border-white/10">
                  <th scope="row" class={`${cell} text-start font-normal`}>
                    <span class="block font-semibold text-ink dark:text-white" dir="ltr">{p.name}</span>
                    <span class="block text-xs text-ink/55 dark:text-white/55">{t(`pricing.pos.${p.key}`)}</span>
                  </th>
                  {p.monthly === null ? (
                    <td colspan="3" class={cell}><span class={price}>{t('pricing.free')}</span></td>
                  ) : (
                    <>
                      <td class={priceCell}><span class={price} dir="ltr">{usd(p.monthly)}</span> <span class={unit}>{t('pricing.perMonth')}</span></td>
                      <td class={priceCell}><span class={price} dir="ltr">{usd(p.yearly!)}</span> <span class={unit}>{t('pricing.perYear')}</span></td>
                      <td class={priceCell}><span class={price} dir="ltr">{usd(p.lifetime!)}</span> <span class={unit}>{t('pricing.oneTime')}</span></td>
                    </>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-ink/65 dark:text-white/65">{t('pricing.pos.billing')}</p>
        <a href={bellopos.pricingUrl(lang)} target="_blank" rel="noopener" class="mt-auto inline-flex w-fit items-center gap-1.5 pt-5 text-sm font-semibold text-accent underline-offset-2 hover:underline">
          {t('pricing.pos.cta')} <span dir="ltr" class="font-normal text-ink/50 dark:text-white/50">(bellopos.app)</span>
        </a>
      </article>

      <!-- BelloSend: EUR subscription, monthly or yearly -->
      <article class={card} style="--reveal-delay:90ms">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-heading text-2xl font-bold">BelloSend</h3>
          <span class={chip}>{t('pricing.send.currency')}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink/65 dark:text-white/65">{t('pricing.send.tagline')}</p>

        <div class="mt-5 overflow-x-auto">
          <table class="w-full text-start text-sm">
            <thead>
              <tr class="border-b border-black/10 text-xs uppercase tracking-wide text-ink/55 dark:border-white/10 dark:text-white/55">
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.plan')}</th>
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.monthly')}</th>
                <th scope="col" class={`${cell} text-start font-semibold`}>{t('pricing.col.yearly')}</th>
              </tr>
            </thead>
            <tbody>
              {bellosend.plans.map((p) => (
                <tr class="border-b border-black/5 last:border-0 dark:border-white/10">
                  <th scope="row" class={`${cell} text-start font-normal`}>
                    <span class="block font-semibold text-ink dark:text-white" dir="ltr">{p.name}</span>
                    <span class="block text-xs text-ink/55 dark:text-white/55">{t(`pricing.send.${p.key}`)}</span>
                  </th>
                  <td class={priceCell}><span class={price} dir="ltr">{eur(p.monthly)}</span> <span class={unit}>{t('pricing.perMonth')}</span></td>
                  <td class={priceCell}><span class={price} dir="ltr">{eur(p.yearly)}</span> <span class={unit}>{t('pricing.perYear')}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-ink/65 dark:text-white/65">{sendCustom}</p>
        <p class="mt-3 text-sm leading-relaxed text-ink/65 dark:text-white/65">{t('pricing.send.billing')}</p>
        <a href={bellosend.pricingUrl(lang)} target="_blank" rel="noopener" class="mt-auto inline-flex w-fit items-center gap-1.5 pt-5 text-sm font-semibold text-accent underline-offset-2 hover:underline">
          {t('pricing.send.cta')} <span dir="ltr" class="font-normal text-ink/50 dark:text-white/50">(bellosend.net)</span>
        </a>
      </article>
    </div>

    <!-- How to pay, which policies apply, and who to ask -->
    <div class="reveal mt-6 rounded-2xl border border-black/10 bg-white p-6 text-sm leading-relaxed text-ink/70 shadow-sm sm:p-8 dark:border-white/10 dark:bg-night-card dark:text-white/70" style="--reveal-delay:180ms">
      <p class="flex items-start gap-2.5 font-semibold text-ink dark:text-white">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        {t('pricing.cards')}
      </p>
      <a
        href={waLink(t('pricing.waMessage'))}
        target="_blank"
        rel="noopener"
        data-cta="pricing-whatsapp"
        class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#1ebe5b]"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.5h-.01a9.45 9.45 0 0 1-4.81-1.32l-.35-.2-3.58.94.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47a9.4 9.4 0 0 1 6.7 2.78 9.4 9.4 0 0 1 2.77 6.7c0 5.22-4.25 9.46-9.48 9.46zm8.06-17.53A11.32 11.32 0 0 0 12.05.63C5.77.63.66 5.74.66 12.02c0 2.01.52 3.97 1.52 5.7L.56 23.63l6.05-1.59a11.37 11.37 0 0 0 5.44 1.39h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.18-5.9-3.34-8.07z"/></svg>
        {t('pricing.waCta')}
      </a>
      <p class="mt-3">
        {t('pricing.policies')}{' '}
        {policies.map((l, i) => (
          <>
            <a href={l.href} class="font-semibold text-accent underline-offset-2 hover:underline">{l.label}</a>{i < policies.length - 1 ? ' · ' : '.'}
          </>
        ))}
      </p>
      <p class="mt-3">
        {t('pricing.support')}{' '}
        <a href={`mailto:${COMPANY.email}`} dir="ltr" class="font-semibold text-accent underline-offset-2 hover:underline">{COMPANY.email}</a>
        <span aria-hidden="true"> · </span>
        <a href={`tel:${COMPANY.phoneE164}`} dir="ltr" class="font-semibold text-accent underline-offset-2 hover:underline">{COMPANY.phoneDisplay}</a>
      </p>
    </div>
  </div>
</section>
