---
import { basePath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Marketplace section: one product today (BelloCommerce), more to come.
const highlights = [t('products.h1'), t('products.h2'), t('products.h3'), t('products.h4')];
---

<section id="products" class="mesh-light py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent">{t('products.kicker')}</p>
      <h2 class="mt-3 font-heading text-[clamp(1.25rem,6vw,1.875rem)] font-bold sm:text-4xl">{t('products.title')}</h2>
      <p class="mt-4 text-lg text-ink/60 dark:text-white/60">{t('products.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-5">
      <!-- BelloCommerce flagship card -->
      <article class="reveal glow-border rounded-3xl border border-black/8 bg-white p-8 shadow-sm dark:border-white/10 dark:bg-night-card sm:p-10">
        <div class="flex flex-wrap items-center gap-4">
          {/* BelloCommerce keeps its own brand orange, on both themes */}
          <div class="grid h-14 w-14 place-items-center rounded-2xl bg-[#fff1ea] dark:bg-[#ff6b35]/15">
            <img src="/bello-logo-accent.svg" alt="" width="32" height="32" class="h-8 w-8" />
          </div>
          <div>
            <h3 class="font-heading font-brand text-lg font-bold">COMMERCE</h3>
            <p class="text-sm font-medium text-ink/50 dark:text-white/50">{t('products.tagline')}</p>
          </div>
          <span class="ms-auto rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-400">{t('products.available')}</span>
        </div>

        <p class="mt-6 text-base leading-relaxed text-ink/65 dark:text-white/65">
          {t('products.desc')}
        </p>

        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {highlights.map((h) => (
            <li class="flex items-center gap-2.5 text-sm font-medium text-ink/75 dark:text-white/75">
              <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
              {h}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {/* Verb and product name are separate flex items (name pinned LTR):
              in Arabic the bidi reordering otherwise glues them together. */}
          <a href={`${basePath}/${lang}/signup/`} class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent/90">
            <span>{t('products.deploy')}</span>
            <span dir="ltr">BelloCommerce</span>
            <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="https://bellocommerce.com" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-full border border-black/15 px-6 py-3 text-sm font-semibold text-ink transition hover:border-black/30 dark:border-white/20 dark:text-white dark:hover:border-white/40">
            {t('products.learn')}
          </a>
        </div>
      </article>

      <!-- Coming soon card -->
      <article class="reveal grid place-items-center rounded-3xl border border-dashed border-black/15 bg-white/50 p-10 text-center dark:border-white/15 dark:bg-white/[0.02]" style="--reveal-delay: 120ms">
        <div>
          <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-cream dark:bg-night-soft">
            <svg class="h-7 w-7 text-ink/30 dark:text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-ink/60 dark:text-white/60">{t('products.soon.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/45 dark:text-white/45">
            {t('products.soon.desc')}
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
