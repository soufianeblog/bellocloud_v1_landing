---
import AboutPage from '../../components/AboutPage.astro';
import { ui, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<AboutPage lang={lang} />
