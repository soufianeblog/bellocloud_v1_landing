---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../lib/i18n';

const t = useTranslations('en');
---

<Base lang="en" title={`${t('404.title')} | BelloCloud`} description={t('404.desc')}>
  <Header lang="en" />
  <main class="mesh-light">
    <div class="mx-auto flex min-h-[60vh] max-w-6xl flex-col items-center justify-center px-5 py-24 text-center sm:px-6">
      <p class="font-heading text-7xl font-bold text-accent">404</p>
      <h1 class="mt-4 font-heading text-2xl font-bold">{t('404.title')}</h1>
      <p class="mt-3 max-w-md text-ink/60 dark:text-white/60">{t('404.desc')}</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3 text-sm font-semibold text-white transition hover:bg-accent/90">
        {t('404.back')}
      </a>
    </div>
  </main>
  <Footer lang="en" />
</Base>
